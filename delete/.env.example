# Local development settings; copy to .env and replace the example password.
POSTGRES_DB=reviews
POSTGRES_USER=reviews
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_1_UI_PORT=8081
SPARK_WORKER_2_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536M
INPUT_PATH=/opt/spark/data/All_Beauty.jsonl
HASH_COLUMNS=user_id,product_id,review_text
JDBC_PARTITIONS=2

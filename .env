# Local development settings; copy to .env and replace the example password.
POSTGRES_DB=reviews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_1_UI_PORT=8081
SPARK_WORKER_2_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536M
INPUT_PATH=https://huggingface.co/datasets/McAuley-Lab/Amazon-Reviews-2023/resolve/main/raw/review_categories/All_Beauty.jsonl
STATES_DIR=/opt/spark/states
COLLECT_BATCH_SIZE=1000
